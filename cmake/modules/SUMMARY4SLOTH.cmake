# ##############################################################################
# Configuration summary
#
# Read-only: this module only prints what CMake resolved (paths, options,
# flags). It does not change any variable or target. Its purpose is to make
# the configuration visible and comparable between machines (Mac/brew,
# Linux/spack, clusters) and between versions of the build system.
# ##############################################################################

function(_sloth_summary_line label value)
  if("${value}" STREQUAL "")
    set(value "-")
  endif()
  # Align values on column 28 (no string(REPEAT): keep CMake 3.12 compatibility)
  set(_spaces " ")
  string(LENGTH "${label}" _len)
  while(_len LESS 26)
    string(APPEND _spaces " ")
    math(EXPR _len "${_len} + 1")
  endwhile()
  message(STATUS "  ${label}${_spaces}${value}")
endfunction()

function(_sloth_summary_target_prop label target prop)
  if(TARGET ${target})
    get_target_property(_val ${target} ${prop})
    if(NOT _val OR _val MATCHES "-NOTFOUND$")
      set(_val "")
    endif()
    list(JOIN _val " " _val)
    _sloth_summary_line("${label}" "${_val}")
  endif()
endfunction()

function(sloth_print_summary)
  string(TOUPPER "${CMAKE_BUILD_TYPE}" _bt)
  get_directory_property(_dir_opts DIRECTORY ${PROJECT_SOURCE_DIR} COMPILE_OPTIONS)
  list(JOIN _dir_opts " " _dir_opts)
  get_directory_property(_dir_incs DIRECTORY ${PROJECT_SOURCE_DIR} INCLUDE_DIRECTORIES)
  list(JOIN _dir_incs " " _dir_incs)

  message(STATUS "")
  message(STATUS "================ SLOTH configuration summary ================")
  _sloth_summary_line("SLOTH version" "${PROJECT_VERSION}")
  _sloth_summary_line("Source dir" "${PROJECT_SOURCE_DIR}")
  _sloth_summary_line("Build dir" "${PROJECT_BINARY_DIR}")
  _sloth_summary_line("Install prefix" "${CMAKE_INSTALL_PREFIX}")
  _sloth_summary_line("Generator" "${CMAKE_GENERATOR}")
  _sloth_summary_line("System" "${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}")
  message(STATUS "-- Compiler")
  _sloth_summary_line("C++ compiler" "${CMAKE_CXX_COMPILER} (${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION})")
  _sloth_summary_line("C++ standard" "${CMAKE_CXX_STANDARD}")
  _sloth_summary_line("Build type" "${CMAKE_BUILD_TYPE}")
  _sloth_summary_line("SLOTH_NATIVE_ARCH" "${SLOTH_NATIVE_ARCH}")
  _sloth_summary_line("SLOTH_ENABLE_LTO" "${SLOTH_ENABLE_LTO} (active: ${SLOTH_LTO_ACTIVE})")
  _sloth_summary_line("CMAKE_CXX_FLAGS" "${CMAKE_CXX_FLAGS}")
  _sloth_summary_line("CMAKE_CXX_FLAGS_${_bt}" "${CMAKE_CXX_FLAGS_${_bt}}")
  _sloth_summary_line("Global compile options" "${_dir_opts}")
  _sloth_summary_line("Global include dirs" "${_dir_incs}")
  _sloth_summary_target_prop("Sloth compile options" Sloth COMPILE_OPTIONS)
  _sloth_summary_target_prop("Sloth definitions" Sloth INTERFACE_COMPILE_DEFINITIONS)
  message(STATUS "-- MFEM and its dependencies")
  if(TARGET SlothMFEM)
    list(JOIN SLOTHMFEM_INCLUDE_DIRS " " _smi)
    list(JOIN SLOTHMFEM_LINK " " _sml)
    _sloth_summary_line("SlothMFEM include dirs" "${_smi}")
    _sloth_summary_line("SlothMFEM link" "${_sml}")
    list(JOIN SLOTHMFEM_MPI_INCLUDE_DIRS " " _smpi)
    list(JOIN SLOTHMFEM_MPI_LIBRARIES " " _smpl)
    _sloth_summary_line("SlothMFEM MPI include" "${_smpi}")
    _sloth_summary_line("SlothMFEM MPI libraries" "${_smpl}")
  endif()
  _sloth_summary_line("MFEM config file" "${MFEM_CONFIG_FILE}")
  _sloth_summary_line("MFEM library" "${MFEM_LIBRARY}")
  _sloth_summary_line("MFEM_USE_MPI" "${MFEM_USE_MPI}")
  _sloth_summary_line("MFEM_USE_SUITESPARSE" "${MFEM_USE_SUITESPARSE}")
  _sloth_summary_line("MFEM_USE_MUMPS" "${MFEM_USE_MUMPS}")
  _sloth_summary_line("MFEM_USE_PETSC" "${MFEM_USE_PETSC}")
  _sloth_summary_line("MFEM_USE_OPENMP" "${MFEM_USE_OPENMP}")
  _sloth_summary_line("HYPRE version" "${HYPRE_VERSION}")
  _sloth_summary_line("MPI C++ compiler" "${MPI_CXX_COMPILER}")
  _sloth_summary_line("MPI launcher" "${MPIEXEC_EXECUTABLE}")
  message(STATUS "-- SLOTH options")
  _sloth_summary_line("SLOTH_USE_SHARED" "${SLOTH_USE_SHARED}")
  _sloth_summary_line("SLOTH_USE_EXPRTK" "${SLOTH_USE_EXPRTK}")
  _sloth_summary_line("SLOTH_USE_VORO" "${SLOTH_USE_VORO}")
  _sloth_summary_line("SLOTH_USE_LIBTORCH" "${SLOTH_USE_LIBTORCH}")
  _sloth_summary_line("SLOTH_USE_EXTERNAL" "${SLOTH_USE_EXTERNAL}")
  if(SLOTH_USE_EXPRTK)
    _sloth_summary_line("ExprTk include dir" "${ExprTk_INCLUDE_DIR}")
  endif()
  if(SLOTH_USE_VORO)
    _sloth_summary_line("Voro++ include dir" "${VORO_INCLUDE_DIR}")
    _sloth_summary_line("Voro++ library" "${VORO_LIBRARY}")
  endif()
  if(SLOTH_USE_EXTERNAL)
    _sloth_summary_line("External lib dir" "${SLOTH_EXTERNAL_LIBDIR}")
    _sloth_summary_line("External lib name" "${SLOTH_EXTERNAL_LIBNAME}")
  endif()
  message(STATUS "-- Python")
  _sloth_summary_line("Python3" "${Python3_EXECUTABLE}")
  _sloth_summary_line("SymPy found" "${SYMPY_FOUND}")
  message(STATUS "-- Environment variables read by CMake")
  foreach(_var CMAKE_PREFIX_PATH MFEM_DIR HYPRE_DIR USER_INSTALL_PATH)
    _sloth_summary_line("${_var}" "$ENV{${_var}}")
  endforeach()
  message(STATUS "=============================================================")
  message(STATUS "")
endfunction()
